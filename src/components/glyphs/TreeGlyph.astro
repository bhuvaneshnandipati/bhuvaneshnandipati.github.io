---
/**
 * The leaf-vein channel tree drawn from the generator geometry (data/coldplate-geom.ts):
 * 4 trunks → 128 channels over six generations, true channel widths, 60 mm plate outline
 * and 40 mm die. On hover, coolant pulses travel outward generation by generation.
 */
import { GEOM } from '../../data/coldplate-geom';
import { segmentGenerations } from '../../lib/coldplate-model';

interface Props { size?: number; animate?: boolean }
const { size = 240, animate = true } = Astro.props;
const s = 240 / 64; // viewBox units per mm
const P = (v: number) => (120 + v * s).toFixed(1);
const Q = (v: number) => (120 - v * s).toFixed(1);
const gens = segmentGenerations();
const nGen = GEOM.rows.length;
const pathFor = (g: number) => GEOM.tree.filter((_, i) => gens[i] === g).map(([x1, y1, x2, y2]) => `M${P(x1)} ${Q(y1)}L${P(x2)} ${Q(y2)}`).join('');
const widths = GEOM.rows.map((r) => r.w_mm * s);
const staticPaths = Array.from({ length: nGen }, (_, g) => `<path d="${pathFor(g)}" stroke-width="${widths[g].toFixed(2)}"/>`).join('');
const pulsePaths = Array.from({ length: nGen }, (_, g) => `<path d="${pathFor(g)}" stroke-width="${(widths[g] * 0.55).toFixed(2)}" style="--g:${g}"/>`).join('');
const geo = GEOM.geo;
const ringR = (geo.r_rim + geo.ring_w / 2) * s;
const outlets = [0, 1, 2, 3].map((k) => { const a = Math.PI / 4 + (k * Math.PI) / 2; return { x: 120 + ringR * Math.cos(a), y: 120 + ringR * Math.sin(a) }; });
---

<svg class:list={['glyph', 'tree', { 'tree--anim': animate }]} viewBox="0 0 240 240" width={size} height={size} role="img" aria-label="Leaf-vein cold plate drawn to scale: four trunks from a central inlet branch over six generations into 128 channels">
  <rect x={P(-30)} y={Q(30)} width={60 * s} height={60 * s} fill="none" stroke="currentColor" stroke-opacity="0.35" />
  <rect x={P(-20)} y={Q(20)} width={40 * s} height={40 * s} fill="none" stroke="currentColor" stroke-opacity="0.35" stroke-dasharray="3 4" />
  <circle cx="120" cy="120" r={ringR} fill="none" stroke="currentColor" stroke-width={geo.ring_w * s} stroke-opacity="0.85" />
  <g stroke="currentColor" stroke-linecap="round" fill="none" set:html={staticPaths} />
  <g class="tree__pulse" stroke="var(--cobalt)" stroke-linecap="round" fill="none" set:html={pulsePaths} />
  <circle cx="120" cy="120" r={(geo.d_in / 2) * s} fill="var(--paper)" stroke="currentColor" stroke-width="1.5" />
  {outlets.map((o) => <circle cx={o.x.toFixed(1)} cy={o.y.toFixed(1)} r={(geo.d_out / 2) * s} fill="var(--paper)" stroke="currentColor" stroke-width="1.5" />)}
</svg>

<style>
  .tree__pulse :global(path) { stroke-dasharray: 5 40; stroke-dashoffset: 45; opacity: 0; }
  .tree--anim:hover .tree__pulse :global(path),
  :global(a:hover) .tree--anim .tree__pulse :global(path),
  :global(a:focus-visible) .tree--anim .tree__pulse :global(path) {
    opacity: 1;
    animation: pulse 1.4s linear infinite;
    animation-delay: calc(var(--g) * 0.12s);
  }
  @keyframes pulse { to { stroke-dashoffset: 0; } }
</style>
