---
import { meridianStreamlines, sphereVelocity } from '../lib/flow';
import { coolwarm, rgb, legendGradient } from '../lib/colormap';
import { site } from '../data/site';

/* Build-time poster: exact meridian-plane streamlines of the same flow, coloured by Cp. */
const W = 1200, H = 500, SX = 92, CX = 640, CY = 250;
const seeds = [0.08, 0.25, 0.45, 0.68, 0.95, 1.25, 1.6, 2.0, 2.45];
const lines = meridianStreamlines(seeds);
const chunks: { d: string; c: string }[] = [];
for (const sign of [1, -1]) {
  for (const pts of lines) {
    for (let i = 0; i < pts.length - 1; i += 6) {
      const seg = pts.slice(i, i + 7);
      const [mx, mr] = seg[Math.floor(seg.length / 2)];
      const u = sphereVelocity(mx, mr, 0);
      const cp = 1 - (u[0] ** 2 + u[1] ** 2);
      const d = seg.map(([x, r], k) => `${k ? 'L' : 'M'}${Math.round(CX + x * SX)} ${Math.round(CY - sign * r * SX)}`).join('');
      chunks.push({ d, c: rgb(coolwarm(0.5 + cp / 1.5)) });
    }
  }
}
const posterPaths = chunks.map((c) => `<path d="${c.d}" stroke="${c.c}"/>`).join('');
const legend = legendGradient((t) => coolwarm(t));
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero__head">
    <p class="hero__who label"><span>{site.name}</span><span class="hero__sep" aria-hidden="true"></span><span>Mechanical engineer · Computational fluid dynamics</span></p>
    <h1 id="hero-title" class="display hero__title">
      <span class="hero__l1">Modeling flow.</span>
      <span class="hero__l2">Solving thermal <em>problems.</em></span>
    </h1>
    <div class="hero__sub">
      <p class="lede">I build CFD models of aerodynamic, thermal and solidification problems, and I report how far each number can be trusted.</p>
      <a class="btn btn--solid" href="#work">See the three studies <span class="arrow" aria-hidden="true">↓</span></a>
    </div>
  </div>

  <div class="wrap">
    <flow-window class="tunnel on-dark" tabindex="0" role="group" aria-label="Live flow field. Move the pointer over it, or use the arrow keys, to probe the flow." aria-describedby="flow-caption">
      <svg class="tunnel__poster" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
        <rect width={W} height={H} fill="#0b0f12" />
        <g fill="none" stroke-width="1.6" stroke-linecap="round" opacity="0.9" set:html={posterPaths} />
        <circle cx={CX} cy={CY} r={SX} fill="#1a2028" stroke="#9fb0bb" stroke-opacity="0.35" />
      </svg>
      <canvas class="tunnel__canvas" aria-hidden="true"></canvas>

      <div class="tunnel__hud tunnel__hud--tl">
        <span class="tag">Test section · live</span>
        <span class="tunnel__flow mono" aria-hidden="true">U<sub>∞</sub> <svg viewBox="0 0 60 10" width="60" height="10"><path d="M0 5h56m-6-4 6 4-6 4" fill="none" stroke="currentColor" stroke-width="1.2"/></svg></span>
      </div>

      <div class="tunnel__hud tunnel__hud--tr" aria-live="polite">
        <dl class="probe mono" data-state="idle">
          <div><dt>x / a</dt><dd data-k="x">—</dd></div>
          <div><dt>r / a</dt><dd data-k="rho">—</dd></div>
          <div><dt>|u| / U<sub>∞</sub></dt><dd data-k="speed">—</dd></div>
          <div><dt>C<sub>p</sub></dt><dd data-k="cp">—</dd></div>
        </dl>
        <p class="probe__hint mono">Point at the flow to probe it</p>
      </div>

      <div class="tunnel__hud tunnel__hud--bl">
        <p class="label">Pressure coefficient C<sub>p</sub></p>
        <div class="legend" style={`background:${legend}`}></div>
        <div class="legend__ticks mono"><span>≤ −0.75</span><span>0</span><span>≥ +0.75</span></div>
      </div>

      <p class="tunnel__caption mono" id="flow-caption">
        Inviscid potential flow past a sphere, solved analytically in your browser. Peak surface speed is 1.5&nbsp;U<sub>∞</sub> (C<sub>p</sub>&nbsp;=&nbsp;−1.25). Real flow separates behind the sphere, which is why the studies below use CFD.
      </p>
    </flow-window>
  </div>
</section>

<script>
  import type { FlowScene, ProbeInfo } from '../scripts/flow-scene';

  const fmt = (v: number, d = 2) => v.toFixed(d).replace('-', '−');

  class FlowWindow extends HTMLElement {
    scene: FlowScene | null = null;
    io?: IntersectionObserver;

    connectedCallback() {
      const canvas = this.querySelector('canvas')!;
      const dl = this.querySelector<HTMLElement>('.probe')!;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const show = (p: ProbeInfo | null) => {
        dl.dataset.state = p ? 'live' : 'idle';
        const set = (k: string, v: string) => { const el = dl.querySelector(`[data-k="${k}"]`); if (el) el.textContent = v; };
        set('x', p ? fmt(p.x) : '—');
        set('rho', p ? fmt(p.rho) : '—');
        set('speed', p ? fmt(p.speed, 3) : '—');
        set('cp', p ? fmt(p.cp, 3) : '—');
      };

      const supportsGL = (() => {
        try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; }
      })();
      if (!supportsGL) return;

      const boot = async () => {
        try {
          const { createFlowScene } = await import('../scripts/flow-scene');
          this.scene = createFlowScene(canvas, this, { reduced, onProbe: show, onError: (e) => console.warn('[flow-hero] WebGL unavailable', e) });
          if (!this.scene) return;
          this.classList.add('is-live');
          this.io = new IntersectionObserver(([e]) => (e.isIntersecting ? this.scene?.start() : this.scene?.stop()), { threshold: 0.01 });
          this.io.observe(this);
          document.addEventListener('visibilitychange', () => (document.hidden ? this.scene?.stop() : this.scene?.start()));
        } catch (e) {
          console.warn('[flow-hero] failed to start; static poster kept', e);
        }
      };
      // Boot on the first sign of a visitor (pointer, key, scroll or touch). Until then the
      // build-time poster of the same flow is shown, which keeps first load light.
      const events = ['pointermove', 'pointerdown', 'keydown', 'wheel', 'touchstart', 'scroll'] as const;
      let started = false;
      const kick = () => {
        if (started) return;
        started = true;
        events.forEach((ev) => window.removeEventListener(ev, kick));
        boot();
      };
      events.forEach((ev) => window.addEventListener(ev, kick, { passive: true }));
      this.addEventListener('focus', kick);

      this.addEventListener('keydown', (e) => {
        const step = 0.15;
        const map: Record<string, [number, number]> = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, step], ArrowDown: [0, -step] };
        const d = map[e.key];
        if (d && this.scene) { e.preventDefault(); this.scene.nudgeProbe(d[0], d[1]); }
      });
    }

    disconnectedCallback() { this.io?.disconnect(); this.scene?.dispose(); }
  }
  customElements.define('flow-window', FlowWindow);
</script>

<style>
  .hero { padding-top: clamp(2rem, 4vw, 4rem); }
  .hero__who { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.9rem; color: var(--mute); }
  .hero__sep { width: 2.5rem; height: 1px; background: currentColor; }
  .hero__title { margin-top: clamp(1.25rem, 2.5vw, 2rem); display: grid; }
  .hero__l2 { color: var(--ink-2); }
  .hero__title em {
    font-family: var(--font-text);
    font-style: italic;
    font-weight: 400;
    font-stretch: 100%;
    letter-spacing: -0.03em;
    color: var(--cobalt);
  }
  .hero__sub {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-block: clamp(1.5rem, 3vw, 2.5rem) clamp(1.75rem, 3vw, 2.75rem);
  }

  .tunnel {
    position: relative;
    display: block;
    height: clamp(380px, 58vh, 680px);
    overflow: hidden;
    background: var(--tunnel);
    color: var(--tunnel-ink);
    border: 1px solid var(--ink);
    cursor: crosshair;
    isolation: isolate;
  }
  .tunnel__poster, .tunnel__canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .tunnel__canvas { opacity: 0; transition: opacity 0.9s var(--ease-out); touch-action: pan-y; }
  .tunnel.is-live .tunnel__canvas { opacity: 1; }
  .tunnel.is-live .tunnel__poster { opacity: 0; transition: opacity 0.9s var(--ease-out) 0.2s; }

  .tunnel__hud { position: absolute; z-index: 2; pointer-events: none; }
  .tunnel__hud--tl { top: 16px; left: 16px; display: grid; gap: 0.9rem; justify-items: start; }
  .tunnel__hud--tr { top: 16px; right: 16px; text-align: right; }
  .tunnel__hud--bl { left: 16px; bottom: 16px; width: min(240px, 46%); }
  .tunnel__flow { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--tunnel-mute); }

  .probe { display: grid; grid-template-columns: repeat(2, auto); gap: 0.35rem 1.25rem; padding: 0.7rem 0.85rem; background: rgb(11 15 18 / 0.72); border: 1px solid var(--tunnel-line); }
  .probe div { display: grid; justify-items: end; }
  .probe dt { font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--tunnel-mute); }
  .probe dd { font-size: 0.95rem; font-variant-numeric: tabular-nums; min-width: 5.5ch; }
  .probe[data-state='live'] dd { color: #fff; }
  .probe__hint { margin-top: 0.5rem; font-size: 0.68rem; color: var(--tunnel-mute); }

  .legend { height: 8px; margin-top: 0.45rem; border: 1px solid var(--tunnel-line); }
  .legend__ticks { display: flex; justify-content: space-between; margin-top: 0.3rem; font-size: 0.66rem; color: var(--tunnel-mute); }
  .tunnel__hud--bl .label { color: var(--tunnel-mute); }

  .tunnel__caption {
    padding: 0.5rem 0.65rem;
    background: rgb(11 15 18 / 0.72);
    border: 1px solid var(--tunnel-line);
    position: absolute;
    right: 16px;
    bottom: 16px;
    z-index: 2;
    max-width: 44ch;
    font-size: 0.68rem;
    line-height: 1.55;
    color: var(--tunnel-mute);
    text-align: right;
    pointer-events: none;
  }

  @media (max-width: 760px) {
    .tunnel { height: clamp(460px, 82vh, 620px); }
    .probe { grid-template-columns: repeat(2, auto); gap: 0.25rem 0.9rem; padding: 0.55rem 0.65rem; }
    .probe dd { font-size: 0.85rem; }
    .tunnel__hud--bl { bottom: auto; top: 16px; left: auto; right: 16px; display: none; }
    .tunnel__hud--tl .tag { display: none; }
    .tunnel__caption { left: 16px; right: 16px; max-width: none; text-align: left; }
    .probe__hint::after { content: ' (tap)'; }
  }
</style>
