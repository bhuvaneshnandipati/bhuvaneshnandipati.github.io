---
/**
 * Interactive check: stagnation-point Cp behind a normal shock (Rayleigh pitot formula,
 * γ = 1.4) against the simulated nose Cp from the Orion report. The curve is computed at
 * build time; the slider recomputes the same functions in the browser.
 */
import { cpMax, cpMaxLimit, normalShock, pitotRatio } from '../lib/gas';
import { linear, ticks, fmt } from '../lib/scale';
import { cpTable } from '../data/orion';

const W = 640, H = 380, m = { l: 58, r: 24, t: 24, b: 52 };
const X = { min: 1, max: 8 }, Y = { min: 1.3, max: 1.9 };
const sx = linear(X.min, X.max, m.l, W - m.r);
const sy = linear(Y.min, Y.max, H - m.b, m.t);
const curve = Array.from({ length: 141 }, (_, i) => 1.05 + (i * (X.max - 1.05)) / 140)
  .map((M) => `${sx(M).toFixed(1)} ${sy(cpMax(M)).toFixed(1)}`);
const sim = [{ M: 2, cp: cpTable[0].m2 }, { M: 6, cp: cpTable[0].m6 }];
const lim = cpMaxLimit();
const M0 = 6;
const ns0 = normalShock(M0);
---

<pitot-check class="pc" data-x0={X.min} data-x1={X.max} data-y0={Y.min} data-y1={Y.max} data-w={W} data-h={H} data-ml={m.l} data-mr={m.r} data-mt={m.t} data-mb={m.b}>
  <div class="pc__plot">
    <div class="pc__scroll" tabindex="0" role="region" aria-label="Stagnation-point Cp chart (scrolls sideways on narrow screens)">
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Stagnation-point pressure coefficient versus Mach number from the Rayleigh pitot formula, with the two simulated nose values: 1.657 at Mach 2 on the curve and 1.85 at Mach 6 slightly above it.">
        <g class="pc__grid">{ticks(Y.min, Y.max, 0.1).map((t) => <line x1={m.l} x2={W - m.r} y1={sy(t)} y2={sy(t)} />)}</g>
        <line x1={m.l} x2={W - m.r} y1={sy(lim)} y2={sy(lim)} class="pc__lim" />
        <text x={m.l + 8} y={sy(lim) - 7} text-anchor="start" class="pc__ann">hypersonic limit, γ = 1.4: {fmt(lim, 3)}</text>
        <g class="pc__axis">
          <line x1={m.l} x2={m.l} y1={m.t} y2={H - m.b} /><line x1={m.l} x2={W - m.r} y1={H - m.b} y2={H - m.b} />
          {ticks(X.min, X.max, 1).map((t) => <text x={sx(t)} y={H - m.b + 18} text-anchor="middle">{t}</text>)}
          {ticks(Y.min, Y.max, 0.1).map((t) => <text x={m.l - 8} y={sy(t) + 4} text-anchor="end">{fmt(t, 1)}</text>)}
          <text x={(m.l + W - m.r) / 2} y={H - 10} text-anchor="middle" class="pc__albl">freestream Mach number</text>
          <text x="14" y={(m.t + H - m.b) / 2} text-anchor="middle" class="pc__albl" transform={`rotate(-90 14 ${(m.t + H - m.b) / 2})`}>Cp at the stagnation point</text>
        </g>
        <path d={`M${curve.join(' L')}`} fill="none" stroke="var(--ink)" stroke-width="2" />
        {sim.map((s) => (
          <g>
            <rect x={sx(s.M) - 6} y={sy(s.cp) - 6} width="12" height="12" fill="var(--warm)" transform={`rotate(45 ${sx(s.M)} ${sy(s.cp)})`} />
            <text x={sx(s.M) + 12} y={sy(s.cp) + (s.M === 6 ? -10 : 18)} class="pc__simlbl">Fluent nose Cp {fmt(s.cp, 3)}</text>
          </g>
        ))}
        <g class="pc__cursor">
          <line class="pc__vline" x1={sx(M0)} x2={sx(M0)} y1={m.t} y2={H - m.b} />
          <circle class="pc__dot" cx={sx(M0)} cy={sy(cpMax(M0))} r="6" />
        </g>
      </svg>
    </div>
    <p class="pc__legend mono"><span><i class="pc__k pc__k--line"></i>Rayleigh pitot, γ = 1.4</span><span><i class="pc__k pc__k--sim"></i>Simulated nose C<sub>p</sub> (report, Table 3)</span><span><i class="pc__k pc__k--dot"></i>Slider</span></p>
  </div>

  <div class="pc__panel">
    <label class="pc__label label" for="pc-mach">Freestream Mach number</label>
    <div class="pc__mrow">
      <input id="pc-mach" type="range" min="1.2" max="8" step="0.05" value={M0} />
      <output class="pc__m num" for="pc-mach">{M0.toFixed(2)}</output>
    </div>
    <dl class="pc__out mono" aria-live="polite">
      <div><dt>C<sub>p,max</sub> (theory)</dt><dd data-o="cp">{fmt(cpMax(M0), 3)}</dd></div>
      <div><dt>p<sub>02</sub> / p<sub>∞</sub></dt><dd data-o="pt">{fmt(pitotRatio(M0), 2)}</dd></div>
      <div><dt>p<sub>2</sub> / p<sub>1</sub> (normal shock)</dt><dd data-o="p">{fmt(ns0.p, 2)}</dd></div>
      <div><dt>T<sub>2</sub> / T<sub>1</sub></dt><dd data-o="T">{fmt(ns0.T, 2)}</dd></div>
      <div><dt>M behind shock</dt><dd data-o="M2">{fmt(ns0.M2, 3)}</dd></div>
    </dl>
    <table class="pc__cmp">
      <caption class="label mute">At the study conditions</caption>
      <thead><tr><th scope="col">Case</th><th scope="col">Theory</th><th scope="col">Fluent</th><th scope="col">Diff.</th></tr></thead>
      <tbody>
        {sim.map((s) => (
          <tr><th scope="row">Mach {s.M}</th><td class="mono">{fmt(cpMax(s.M), 3)}</td><td class="mono">{fmt(s.cp, 3)}</td><td class="mono">{(s.cp / cpMax(s.M) - 1 >= 0 ? '+' : '')}{fmt((s.cp / cpMax(s.M) - 1) * 100, 2)}%</td></tr>
        ))}
      </tbody>
    </table>
  </div>
</pitot-check>

<script>
  import { cpMax, normalShock, pitotRatio } from '../lib/gas';
  class PitotCheck extends HTMLElement {
    connectedCallback() {
      const d = this.dataset;
      const n = (k: string) => Number(d[k]);
      const sx = (M: number) => n('ml') + ((M - n('x0')) / (n('x1') - n('x0'))) * (n('w') - n('ml') - n('mr'));
      const sy = (v: number) => n('h') - n('mb') - ((v - n('y0')) / (n('y1') - n('y0'))) * (n('h') - n('mb') - n('mt'));
      const range = this.querySelector<HTMLInputElement>('#pc-mach')!;
      const out = this.querySelector<HTMLOutputElement>('.pc__m')!;
      const vline = this.querySelector<SVGLineElement>('.pc__vline')!;
      const dot = this.querySelector<SVGCircleElement>('.pc__dot')!;
      const f = (v: number, k: number) => v.toFixed(k).replace('-', '−');
      const set = (sel: string, v: string) => { const el = this.querySelector(`[data-o="${sel}"]`); if (el) el.textContent = v; };
      const update = () => {
        const M = Number(range.value);
        const cp = cpMax(M);
        const ns = normalShock(M);
        out.textContent = M.toFixed(2);
        vline.setAttribute('x1', String(sx(M))); vline.setAttribute('x2', String(sx(M)));
        dot.setAttribute('cx', String(sx(M))); dot.setAttribute('cy', String(sy(cp)));
        set('cp', f(cp, 3)); set('pt', f(pitotRatio(M), 2)); set('p', f(ns.p, 2)); set('T', f(ns.T, 2)); set('M2', f(ns.M2, 3));
      };
      range.addEventListener('input', update);
      update();
    }
  }
  customElements.define('pitot-check', PitotCheck);
</script>

<style>
  .pc { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start; }
  @media (max-width: 960px) { .pc { grid-template-columns: minmax(0, 1fr); } }
  .pc__scroll { overflow-x: auto; border-top: 1px solid var(--ink); padding-top: 0.75rem; }
  .pc svg { width: 100%; min-width: 480px; height: auto; }
  .pc__grid line { stroke: var(--hair); }
  .pc__axis line { stroke: var(--ink); }
  .pc__axis text { font-family: var(--font-mono); font-size: 12px; fill: var(--mute); }
  .pc__axis .pc__albl { fill: var(--ink-2); font-size: 12.5px; }
  .pc__lim { stroke: var(--mute); stroke-dasharray: 4 4; }
  .pc__ann { font-family: var(--font-mono); font-size: 11.5px; fill: var(--mute); }
  .pc__simlbl { font-family: var(--font-mono); font-size: 12px; fill: var(--warm); font-weight: 600; }
  .pc__vline { stroke: var(--cobalt); stroke-dasharray: 3 3; }
  .pc__dot { fill: var(--cobalt); stroke: #fff; stroke-width: 2; }
  .pc__legend { display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem; margin-top: 0.6rem; font-size: 0.72rem; color: var(--mute); }
  .pc__k { display: inline-block; width: 14px; height: 10px; margin-right: 0.4rem; vertical-align: -1px; }
  .pc__k--line { height: 2px; background: var(--ink); vertical-align: 3px; }
  .pc__k--sim { width: 9px; height: 9px; background: var(--warm); transform: rotate(45deg); }
  .pc__k--dot { width: 10px; height: 10px; border-radius: 50%; background: var(--cobalt); }

  .pc__panel { display: grid; gap: 1.25rem; padding: clamp(1.25rem, 2.5vw, 2rem); border: 1px solid var(--ink); background: var(--paper); }
  .pc__mrow { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1rem; align-items: center; }
  .pc__mrow input { width: 100%; accent-color: var(--cobalt); min-height: 44px; }
  .pc__m { font-family: var(--font-display); font-weight: 700; font-stretch: 66%; font-size: 3rem; line-height: 1; min-width: 4ch; text-align: right; }
  .pc__out { display: grid; gap: 0.1rem; font-size: 0.85rem; }
  .pc__out div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.4rem 0; border-bottom: 1px solid var(--hair); }
  .pc__out dt { color: var(--mute); }
  .pc__out dd { font-weight: 600; }
  .pc__cmp { width: 100%; font-size: 0.85rem; }
  .pc__cmp caption { text-align: left; padding-bottom: 0.5rem; }
  .pc__cmp th, .pc__cmp td { padding: 0.45rem 0.3rem 0.45rem 0; border-bottom: 1px solid var(--hair); text-align: left; }
  .pc__cmp thead th { font-family: var(--font-mono); font-size: 0.64rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mute); }
  .pc__cmp tbody th { font-weight: 500; }
</style>
