---
/**
 * Schematic of the 20 mm tyre–road gap and the two near-wall meshes of the F1 study.
 * A: snappyHexMesh cells cut at the tyre surface, no prism layer.
 * B: the same hex grid plus one prism layer that follows the tyre surface.
 * The gap height is to scale against the 26 cm window; cell size and tyre curvature are
 * illustrative (the real meshes are shown in the study PDF).
 */
interface Props { variant: 'A' | 'B' }
const { variant } = Astro.props;
const W = 640, H = 250;
const mm = W / 260; // 26 cm window
const roadY = H - 38;
const gap = 20 * mm;
const R = 330 * mm; // illustrative tyre radius
const cx = W / 2, cy = roadY - gap - R;
const surf = (x: number) => cy + Math.sqrt(R * R - (x - cx) ** 2);
const layer = 3.2 * mm; // illustrative prism-layer thickness
const cell = 6 * mm;
const N = 64;
const arc = (off: number) => Array.from({ length: N + 1 }, (_, i) => { const x = (i / N) * W; return [x, surf(x) + off] as [number, number]; });
const toPath = (pts: [number, number][]) => pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`).join('');
const top = variant === 'B' ? layer : 0;
const clip = `${toPath(arc(top))}L${W} ${roadY}L0 ${roadY}Z`;
const tyre = `${toPath(arc(0))}L${W} 0L0 0Z`;
let grid = '';
for (let x = 0; x <= W; x += cell) grid += `M${x.toFixed(1)} 0V${roadY}`;
for (let y = roadY; y >= 0; y -= cell) grid += `M0 ${y.toFixed(1)}H${W}`;
let prisms = '';
if (variant === 'B') {
  const a = arc(0), b = arc(layer);
  prisms = toPath(b) + a.filter((_, i) => i % 2 === 0).map(([x, y], i) => `M${x.toFixed(1)} ${y.toFixed(1)}L${b[i * 2][0].toFixed(1)} ${b[i * 2][1].toFixed(1)}`).join('');
}
const id = `ms-${variant}`;
---

<svg class="ms" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={variant === 'A'
  ? 'Schematic of mesh A: hexahedral cells cut off at the tyre surface in the 20 millimetre gap, with no layer following the wall'
  : 'Schematic of mesh B: the same hexahedral cells plus one thin prism layer that follows the tyre surface'}>
  <defs><clipPath id={id}><path d={clip} /></clipPath></defs>
  <rect x="0" y={roadY} width={W} height={H - roadY} class="ms__road" />
  <path d={grid} clip-path={`url(#${id})`} class="ms__grid" />
  {variant === 'B' && <path d={prisms} class="ms__layer" />}
  <path d={tyre} class="ms__tyre" />
  <line x1="0" y1={roadY} x2={W} y2={roadY} class="ms__roadline" />
  <g class="ms__dim">
    <line x1={cx + 70} y1={roadY - gap} x2={cx + 70} y2={roadY} />
    <line x1={cx + 62} y1={roadY - gap} x2={cx + 78} y2={roadY - gap} />
    <line x1={cx + 62} y1={roadY} x2={cx + 78} y2={roadY} />
    <text x={cx + 86} y={roadY - gap / 2 + 5}>20 mm</text>
  </g>
  <text x="12" y="24" class="ms__lab">{variant === 'A' ? 'A · no prism layer' : 'B · 1 prism layer (88% coverage)'}</text>
  <text x="12" y={H - 12} class="ms__small">moving road →</text>
  {variant === 'B' && <text x={W - 12} y="24" text-anchor="end" class="ms__small ms__accent">layer follows the tyre wall</text>}
</svg>

<style>
  .ms { display: block; width: 100%; height: auto; background: #fff; border: 1px solid var(--ink); }
  .ms__road { fill: var(--paper-2); }
  .ms__roadline { stroke: var(--ink); stroke-width: 2.5; }
  .ms__grid { fill: none; stroke: #9aa3a8; stroke-width: 0.8; }
  .ms__layer { fill: none; stroke: var(--cobalt); stroke-width: 1.2; }
  .ms__tyre { fill: #3a3f43; }
  .ms__dim line { stroke: var(--warm); stroke-width: 1.4; }
  .ms__dim text { font-family: var(--font-mono); font-size: 13px; fill: var(--warm); }
  .ms__lab { font-family: var(--font-mono); font-size: 14px; fill: #fff; font-weight: 600; }
  .ms__small { font-family: var(--font-mono); font-size: 12px; fill: var(--mute); }
  .ms__accent { fill: #b9c6ff; }
</style>
