---
/**
 * Horizontal bar chart in HTML (labels stay legible at any width). Supports several
 * series per row and diverging values around zero. Positions are percentages of one
 * linear scale, so every bar is drawn to scale.
 */
import { fmt, ticks } from '../../lib/scale';

interface Series { label: string; color: string; activeFor?: string }
interface Props {
  title: string;
  rows: { label: string; values: (number | null)[] }[];
  series: Series[];
  min: number;
  max: number;
  step: number;
  unit?: string;
  digits?: number;
  signed?: boolean;
  axisLabel?: string;
  caption?: string;
}
const { title, rows, series, min, max, step, unit = '', digits = 0, signed = false, axisLabel, caption } = Astro.props;
const pct = (v: number) => ((v - min) / (max - min)) * 100;
const zero = pct(Math.max(min, Math.min(max, 0)));
const label = (v: number) => `${signed && v > 0 ? '+' : ''}${fmt(v, digits)}${unit ? ` ${unit}` : ''}`;
const tks = ticks(min, max, step);
---

<figure class="brs">
  <figcaption class="brs__head">
    <span class="brs__title">{title}</span>
    {series.length > 1 && (
      <span class="brs__legend mono">
        {series.map((s) => <span data-active-for={s.activeFor}><i style={`background:${s.color}`}></i>{s.label}</span>)}
      </span>
    )}
  </figcaption>
  <div class="brs__plot" role="table" aria-label={title}>
    {rows.map((r) => (
      <div class="brs__row" role="row">
        <span class="brs__label" role="rowheader">{r.label}</span>
        <span class="brs__track" role="cell">
          <span class="brs__zero" style={`left:${zero}%`} aria-hidden="true"></span>
          {r.values.map((v, i) => v === null ? null : (
            <span class="brs__bar" data-active-for={series[i].activeFor} style={`--c:${series[i].color}; left:${Math.min(zero, pct(v))}%; width:${Math.abs(pct(v) - zero)}%; top:${(i / r.values.length) * 100}%; height:${100 / r.values.length}%`}>
              <span class:list={['brs__val', 'mono', { 'brs__val--neg': v < 0 }]}>
                <span class="sr-only">{series[i].label}: </span>{label(v)}
              </span>
            </span>
          ))}
        </span>
      </div>
    ))}
    <div class="brs__axis" aria-hidden="true">
      <span></span>
      <span class="brs__ticks">
        {tks.map((t) => <span class="mono" style={`left:${pct(t)}%`}>{fmt(t, Number.isInteger(step) ? 0 : 2)}</span>)}
      </span>
    </div>
    {axisLabel && <p class="brs__axislabel mono" aria-hidden="true">{axisLabel}</p>}
  </div>
  {caption && <p class="brs__cap" set:html={caption} />}
</figure>

<style>
  .brs { min-width: 0; }
  .brs__head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1.5rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--ink); }
  .brs__title { font-family: var(--font-display); font-weight: 650; font-stretch: 85%; font-size: 1.1rem; }
  .brs__legend { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; font-size: 0.72rem; color: var(--mute); }
  .brs__legend i { display: inline-block; width: 10px; height: 10px; margin-right: 0.4rem; vertical-align: -1px; }
  .brs__plot { display: grid; padding-top: 0.5rem; }
  .brs__row { display: grid; grid-template-columns: minmax(7rem, 13rem) minmax(0, 1fr); gap: 1rem; align-items: center; min-height: 3rem; border-bottom: 1px solid var(--hair); }
  .brs__label { font-size: 0.9rem; line-height: 1.25; }
  .brs__track { position: relative; height: 2.2rem; margin-inline: 3.6rem; }
  .brs__zero { position: absolute; top: -0.4rem; bottom: -0.4rem; width: 1px; background: var(--ink); }
  .brs__bar { position: absolute; display: block; }
  .brs__bar::before { content: ''; position: absolute; inset: 2px 0; background: var(--c); transition: opacity 0.3s; }
  .brs__val { position: absolute; left: 100%; top: 50%; transform: translateY(-50%); padding-left: 0.4rem; font-size: 0.72rem; white-space: nowrap; color: var(--ink); }
  .brs__val--neg { left: auto; right: 100%; padding-left: 0; padding-right: 0.4rem; }
  .brs__axis { display: grid; grid-template-columns: minmax(7rem, 13rem) minmax(0, 1fr); gap: 1rem; height: 1.6rem; }
  .brs__ticks { position: relative; margin-inline: 3.6rem; }
  .brs__ticks span { position: absolute; top: 0.4rem; transform: translateX(-50%); font-size: 0.66rem; color: var(--mute); }
  .brs__axislabel { text-align: right; font-size: 0.68rem; color: var(--mute); margin-top: 0.3rem; }
  .brs__cap { margin-top: 0.9rem; font-size: 0.92rem; color: var(--ink-2); max-width: 70ch; }
  :global(state-switch[data-state]) .brs .brs__bar[data-active-for]:not(.is-active)::before { opacity: 0.22; }
  @media (max-width: 560px) {
    .brs__row { grid-template-columns: minmax(0, 1fr); gap: 0.2rem; padding-block: 0.5rem; }
    .brs__axis { grid-template-columns: minmax(0, 1fr); }
    .brs__axis > span:first-child { display: none; }
    .brs__track, .brs__ticks { margin-inline: 2.9rem; }
  }
</style>
