---
/**
 * Build-time SVG line/point plot on linear axes. Narrow screens scroll the plot
 * horizontally inside its own container rather than shrinking the type.
 */
import { linear, ticks, fmt } from '../../lib/scale';

interface Axis { min: number; max: number; step: number; label: string; digits?: number }
interface Series { label: string; color: string; points: [number, number][]; dash?: string; markers?: boolean; labels?: boolean; labelDigits?: number; width?: number }
interface Props {
  title: string;
  x: Axis;
  y: Axis;
  series: Series[];
  width?: number;
  height?: number;
  hlines?: { y: number; label: string; color?: string }[];
  desc: string;
  caption?: string;
  id?: string;
}
const { title, x, y, series, width = 640, height = 360, hlines = [], desc, caption, id } = Astro.props;
const m = { l: 58, r: 22, t: 22, b: 52 };
const sx = linear(x.min, x.max, m.l, width - m.r);
const sy = linear(y.min, y.max, height - m.b, m.t);
const xt = ticks(x.min, x.max, x.step);
const yt = ticks(y.min, y.max, y.step);
const d = (pts: [number, number][]) => pts.map(([a, b], i) => `${i ? 'L' : 'M'}${sx(a).toFixed(1)} ${sy(b).toFixed(1)}`).join('');
---

<figure class="lp" id={id}>
  <figcaption class="lp__head">
    <span class="lp__title">{title}</span>
    {series.length > 1 && (
      <span class="lp__legend mono" aria-hidden="true">
        {series.map((s) => <span><svg width="22" height="8"><line x1="0" y1="4" x2="22" y2="4" stroke={s.color} stroke-width="2" stroke-dasharray={s.dash} /></svg>{s.label}</span>)}
      </span>
    )}
  </figcaption>
  <div class="lp__scroll" tabindex="0" role="region" aria-label={`${title} (scrolls sideways on narrow screens)`}>
    <svg class="lp__svg" viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`${title}. ${desc}`}>
      <g class="lp__grid">
        {yt.map((t) => <line x1={m.l} x2={width - m.r} y1={sy(t)} y2={sy(t)} />)}
      </g>
      {y.min < 0 && y.max > 0 && <line x1={m.l} x2={width - m.r} y1={sy(0)} y2={sy(0)} stroke="var(--ink)" stroke-width="1" />}
      {hlines.map((h) => (
        <g>
          <line x1={m.l} x2={width - m.r} y1={sy(h.y)} y2={sy(h.y)} stroke={h.color ?? 'var(--mute)'} stroke-dasharray="4 4" />
          <text x={width - m.r} y={sy(h.y) - 6} text-anchor="end" class="lp__ann">{h.label}</text>
        </g>
      ))}
      <g class="lp__axis">
        <line x1={m.l} x2={m.l} y1={m.t} y2={height - m.b} />
        <line x1={m.l} x2={width - m.r} y1={height - m.b} y2={height - m.b} />
        {xt.map((t) => <text x={sx(t)} y={height - m.b + 18} text-anchor="middle">{fmt(t, x.digits ?? 0)}</text>)}
        {yt.map((t) => <text x={m.l - 8} y={sy(t) + 4} text-anchor="end">{fmt(t, y.digits ?? 0)}</text>)}
        <text x={(m.l + width - m.r) / 2} y={height - 10} text-anchor="middle" class="lp__albl">{x.label}</text>
        <text x={14} y={(m.t + height - m.b) / 2} text-anchor="middle" class="lp__albl" transform={`rotate(-90 14 ${(m.t + height - m.b) / 2})`}>{y.label}</text>
      </g>
      {series.map((s) => (
        <g>
          {s.points.length > 1 && <path d={d(s.points)} fill="none" stroke={s.color} stroke-width={s.width ?? 2} stroke-dasharray={s.dash} stroke-linejoin="round" />}
          {s.markers !== false && s.points.map(([a, b]) => <circle cx={sx(a)} cy={sy(b)} r="4.2" fill={s.dash ? 'var(--paper)' : s.color} stroke={s.color} stroke-width="1.6" />)}
          {s.labels && s.points.map(([a, b]) => <text x={sx(a)} y={sy(b) - 10} text-anchor="middle" class="lp__pt" fill={s.color}>{fmt(b, s.labelDigits ?? 0)}</text>)}
        </g>
      ))}
      <slot />
    </svg>
  </div>
  {caption && <p class="lp__cap" set:html={caption} />}
</figure>

<style>
  .lp { min-width: 0; }
  .lp__head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.4rem 1.5rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--ink); }
  .lp__title { font-family: var(--font-display); font-weight: 650; font-stretch: 85%; font-size: 1.1rem; }
  .lp__legend { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; font-size: 0.72rem; color: var(--mute); }
  .lp__legend svg { display: inline-block; margin-right: 0.4rem; vertical-align: 0; }
  .lp__scroll { overflow-x: auto; margin-top: 0.75rem; }
  .lp__svg { width: 100%; min-width: 480px; height: auto; overflow: visible; }
  .lp__grid line { stroke: var(--hair); }
  .lp__axis line { stroke: var(--ink); }
  .lp__axis text { font-family: var(--font-mono); font-size: 12px; fill: var(--mute); }
  .lp__axis .lp__albl { fill: var(--ink-2); font-size: 12.5px; }
  .lp__ann { font-family: var(--font-mono); font-size: 11.5px; fill: var(--mute); }
  .lp__pt { font-family: var(--font-mono); font-size: 12.5px; font-weight: 600; }
  .lp__cap { margin-top: 0.8rem; font-size: 0.92rem; color: var(--ink-2); max-width: 70ch; }
</style>
