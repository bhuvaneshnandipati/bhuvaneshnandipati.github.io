---
import { nav, site } from '../data/site';
interface Props { sheet: { n: number; label: string } }
const { sheet } = Astro.props;
const TOTAL = 5;
---

<header class="hdr no-print">
  <div class="wrap hdr__bar">
    <a class="mark" href="/">
      <svg class="mark__glyph" viewBox="0 0 32 32" aria-hidden="true">
        <circle cx="16" cy="16" r="6.5" fill="none" stroke="currentColor" stroke-width="2" />
        <path d="M1 9.5c6 0 8.5 1.5 9.6 3.6M1 22.5c6 0 8.5-1.5 9.6-3.6M21.4 13.1C22.5 11 25 9.5 31 9.5M21.4 18.9c1.1 2.1 3.6 3.6 9.6 3.6M1 16h8.5M23.5 16H31" fill="none" stroke="currentColor" stroke-width="1.6" />
      </svg>
      <span class="mark__text">
        <span class="mark__name">{site.shortName}</span>
        <span class="mark__sub">CFD · Thermal-fluid</span>
      </span>
      <span class="sr-only">, home</span>
    </a>

    <nav class="nav" aria-label="Main">
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-list">
        <span class="nav__toggle-label">Index</span>
        <span class="nav__burger" aria-hidden="true"><i></i><i></i></span>
      </button>
      <ul class="nav__list" id="nav-list">
        {nav.map((item) => (
          <li><a href={item.href}><span class="nav__i">{item.index}</span>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <p class="sheet" aria-label={`Sheet ${sheet.n} of ${TOTAL}: ${sheet.label}`}>
      <span class="sheet__k">Sheet</span>
      <span class="sheet__v">{String(sheet.n).padStart(2, '0')}<span class="sheet__of">/{String(TOTAL).padStart(2, '0')}</span></span>
    </p>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.nav__toggle');
  const list = document.getElementById('nav-list');
  if (btn && list) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      document.documentElement.classList.toggle('nav-open', open);
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    list.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { set(false); btn.focus(); }
    });
  }
</script>

<style>
  .hdr {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: saturate(1.2) blur(8px);
    -webkit-backdrop-filter: saturate(1.2) blur(8px);
    border-bottom: 1px solid var(--rule);
  }
  .hdr::before {
    content: '';
    position: fixed;
    inset: 0 0 auto;
    height: env(safe-area-inset-top, 0px);
    background: var(--paper);
    z-index: -1;
  }
  .hdr__bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    min-height: 64px;
  }
  .mark { display: inline-flex; align-items: center; gap: 0.7rem; text-decoration: none; }
  .mark__glyph { width: 30px; height: 30px; color: var(--ink); }
  .mark:hover .mark__glyph { color: var(--cobalt); }
  .mark__text { display: grid; line-height: 1.1; }
  .mark__name { font-family: var(--font-display); font-weight: 700; font-stretch: 85%; font-size: 1.05rem; letter-spacing: -0.01em; }
  .mark__sub { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mute); }

  .nav { justify-self: end; }
  .nav__list { display: flex; gap: clamp(1rem, 2.4vw, 2.4rem); list-style: none; }
  .nav__list a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45em;
    padding: 0.6rem 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    background: linear-gradient(var(--cobalt), var(--cobalt)) left calc(100% - 0.35rem) / 0 1px no-repeat;
    transition: background-size 0.3s var(--ease-out), color 0.2s;
  }
  .nav__list a:hover { color: var(--cobalt); background-size: 100% 1px; }
  .nav__i { font-size: 0.66rem; color: var(--mute); }
  .nav__toggle { display: none; }

  .sheet { display: grid; justify-items: end; line-height: 1.05; padding-left: 1rem; border-left: 1px solid var(--rule); }
  .sheet__k { font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--mute); }
  .sheet__v { font-family: var(--font-display); font-weight: 700; font-stretch: 70%; font-size: 1.25rem; font-variant-numeric: tabular-nums; }
  .sheet__of { color: var(--mute); font-weight: 500; }

  @media (max-width: 760px) {
    .hdr__bar { grid-template-columns: auto 1fr auto; }
    .nav__toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      min-height: 44px;
      padding: 0 0.25rem;
      background: none;
      border: 0;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      cursor: pointer;
    }
    .nav__burger { display: grid; gap: 5px; width: 20px; }
    .nav__burger i { display: block; height: 1.5px; background: currentColor; transition: transform 0.25s var(--ease-out); }
    :global(.nav-open) .nav__burger i:first-child { transform: translateY(3.25px) rotate(45deg); }
    :global(.nav-open) .nav__burger i:last-child { transform: translateY(-3.25px) rotate(-45deg); }
    .nav__list {
      position: fixed;
      inset: calc(64px + env(safe-area-inset-top, 0px)) 0 auto 0;
      display: grid;
      gap: 0;
      padding: 0.5rem var(--gutter-r) 1.5rem var(--gutter);
      background: var(--paper);
      border-bottom: 1px solid var(--ink);
      transform: translateY(-8px);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.2s, transform 0.25s var(--ease-out), visibility 0s linear 0.25s;
    }
    :global(.nav-open) .nav__list { opacity: 1; transform: none; visibility: visible; transition-delay: 0s; }
    .nav__list li { border-bottom: 1px solid var(--hair); }
    .nav__list a { width: 100%; padding: 1rem 0; font-family: var(--font-display); font-size: 1.9rem; font-weight: 650; font-stretch: 80%; letter-spacing: -0.01em; background: none; }
    .nav__i { font-family: var(--font-mono); font-size: 0.72rem; min-width: 2.2rem; }
    .sheet { display: none; }
    .nav { grid-column: 3; }
  }
  @media (max-width: 760px) and (scripting: none) {
    .nav__toggle { display: none; }
    .nav__list { position: static; opacity: 1; visibility: visible; transform: none; display: flex; flex-wrap: wrap; gap: 0 1rem; padding: 0; border: 0; background: none; }
    .nav__list li { border: 0; }
    .nav__list a { font-size: 0.8rem; font-family: var(--font-mono); padding: 0.4rem 0; }
  }
</style>
