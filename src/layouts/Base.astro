---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import serifLatin from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import serifItalicLatin from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-italic.woff2?url';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  sheet: { n: number; label: string };
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description = site.description, sheet, ogType = 'website', jsonLd = [], noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · CFD & thermal-fluid engineering`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: 'Mechanical Engineer',
  knowsAbout: ['Computational fluid dynamics', 'OpenFOAM', 'ANSYS Fluent', 'Heat transfer', 'Aerodynamics', 'Continuous casting', 'Solidification modeling'],
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Purdue University Northwest' },
  email: `mailto:${site.email}`,
  sameAs: [site.linkedin],
  url: Astro.site?.toString(),
};
const ld = [person, ...jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ecede8" />
    <meta name="color-scheme" content="light" />
    <meta name="author" content={site.name} />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifItalicLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sai Bhuvanesh Nandipati: Modeling flow. Solving thermal problems." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>document.documentElement.classList.add('js');</script>
    {ld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader sheet={sheet} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>

<style>
  .skip {
    position: fixed;
    left: 12px;
    top: -100px;
    z-index: 100;
    padding: 12px 16px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-decoration: none;
  }
  .skip:focus { top: max(12px, env(safe-area-inset-top, 0px)); }
  main:focus { outline: none; }
</style>
